{
  "name": "estanteria-wallpaper",
  "productName": "Estanteria",
  "version": "1.0.0",
  "description": "Un escritorio con forma de estanteria: tus carpetas son botellas.",
  "main": "main.js",
  "author": "Esther",
  "homepage": "https://github.com/pkatheassh0l3/Botellitas-wallpaper",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "ventana": "electron . --ventana",
    "depurar": "electron . --ventana --depurar",
    "build": "electron-builder",
    "carpeta": "electron-builder --dir",
    "portable": "electron-builder --win portable",
    "release": "electron-builder --publish always",
    "version:patch": "npm version patch && git push --follow-tags",
    "version:minor": "npm version minor && git push --follow-tags",
    "version:major": "npm version major && git push --follow-tags",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "optionalDependencies": {
    "koffi": "^2.9.0"
  },
  "build": {
    "appId": "com.esther.estanteria",
    "productName": "Estanteria",
    "artifactName": "Estanteria-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "win-wallpaper.js",
      "renderer/**",
      "assets/**",
      "build/icon.png"
    ],
    "asarUnpack": [
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Estantería",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "estanteria",
      "artifactName": "Estanteria-${version}-${arch}.${ext}",
      "synopsis": "Un escritorio con forma de estantería",
      "maintainer": "Esther <103638777+pkatheassh0l3@users.noreply.github.com>",
      "desktop": {
        "Name": "Estantería"
      }
    },
    "portable": {
      "artifactName": "Estanteria-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "wmctrl",
        "libappindicator3-1"
      ]
    }
  }
}
